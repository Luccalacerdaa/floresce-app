# Copie para .env.local e preencha. Nenhuma variável é obrigatória para rodar localmente.

# Pixel do Meta (Gerenciador de Eventos)
NEXT_PUBLIC_META_PIXEL_ID=

# Link do checkout do produto "Membro Fundador" na Kirvano (ou outro gateway).
# As UTMs da visita são anexadas automaticamente.
NEXT_PUBLIC_CHECKOUT_URL=

# E-mail de contato exibido no rodapé e na Política de Privacidade
NEXT_PUBLIC_CONTACT_EMAIL=

# Opcional: número real de vagas do beta (só preencha se for verdade)
NEXT_PUBLIC_FOUNDER_SPOTS=

# Opcional: link do grupo de WhatsApp dos fundadores (aparece na página /obrigado)
NEXT_PUBLIC_FOUNDERS_GROUP_URL=

# Supabase (servidor). Sem isso, os leads só aparecem no log.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: webhook do n8n para cada lead novo (ex.: WhatsApp de boas-vindas)
LEAD_WEBHOOK_URL=
